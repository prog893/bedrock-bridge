#!/bin/sh
# Tracked pre-commit hook. Enable once per clone with:
#   git config core.hooksPath scripts/git-hooks
#
# Runs ruff on the staged Python files: `ruff check --fix`, then `ruff format`.
# If either changed a file, the commit stops so you can review the fixes, stage
# them and commit again. Errors ruff cannot fix also stop the commit. Tests do
# not run here: CI runs the offline suite on every pull request, and the
# functional suite and the e2e grader run by hand per the PR template.
#
# Uses ruff from $RUFF, PATH, or the workspace-parent or repo .venv, else
# `uvx ruff`. If none is available the hook skips rather than blocking.
set -e
set -f

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
[ -n "$files" ] || exit 0

if [ -n "$RUFF" ]; then
    set -- "$RUFF"
elif command -v ruff >/dev/null 2>&1; then
    set -- ruff
elif [ -x "$repo_root/../.venv/bin/ruff" ]; then
    set -- "$repo_root/../.venv/bin/ruff"
elif [ -x "$repo_root/.venv/bin/ruff" ]; then
    set -- "$repo_root/.venv/bin/ruff"
elif command -v uvx >/dev/null 2>&1; then
    set -- uvx ruff
else
    echo "pre-commit: ruff not found; skipping lint (install uv or ruff)" >&2
    exit 0
fi

before=$(cat $files | cksum)
"$@" check --fix --quiet $files
"$@" format --quiet $files
after=$(cat $files | cksum)

if [ "$before" != "$after" ]; then
    echo "pre-commit: ruff fixed or reformatted staged files; review, stage and commit again:" >&2
    git diff --name-only -- $files | sed 's/^/  /' >&2
    exit 1
fi
